// Shared components, as in the sibling apps (FitnessVR, DesktopVR). Colours, type and spacing come only from Tokens.
//
// Motion (all of it off when Mode.reduce-motion, which follows Windows' "Animation effects"):
// - presses answer on pointer-down (pressed colour at once) and ease back over motion-fast;
// - things that travel (segment highlight, switch knob, toast, row height) use an expo-out curve: they start at
//   once and settle without overshoot, like a critically damped spring, and a new target mid-flight continues
//   from where they are (Slint animates from the current value), so every motion is interruptible;
// - numbers that change (GPU saved) count to the new value over motion-fill so the change is seen.
import { Tokens, Mode } from "@tokens";

export global Motion {
    out property <duration> fast: Mode.reduce-motion ? 0ms : Tokens.motion-fast;
    out property <duration> fade: Mode.reduce-motion ? 0ms : Tokens.motion-fade;
    out property <duration> slow: Mode.reduce-motion ? 0ms : Tokens.motion-slow;
    out property <duration> fill: Mode.reduce-motion ? 0ms : Tokens.motion-fill;
}

export component Hit inherits TouchArea {
    mouse-cursor: pointer;
}

export component Caption inherits Text {
    color: Tokens.ink2;
    font-size: Tokens.type-small;
    font-family: Tokens.font-body;
    vertical-alignment: center;
}

// A heading for the card below it: more room above than below, so it reads with its own card.
export component SectionHead inherits VerticalLayout {
    in property <string> text;
    padding-top: Tokens.space-4;
    Caption {
        text: root.text;
    }
}

export component Body inherits Text {
    color: Tokens.ink;
    font-size: Tokens.type-body;
    font-family: Tokens.font-body;
    vertical-alignment: center;
}

// Page heading: Anton, upper case (callers pass upper-case text).
export component Title inherits Text {
    color: Tokens.ink;
    font-size: Tokens.type-title;
    font-family: Tokens.font-display;
    vertical-alignment: center;
}

// Line icon on a 24-unit grid: one 2.2 px line, round caps, as every sibling app draws them.
export component Icon inherits Path {
    in property <string> d;
    in property <brush> color: Tokens.ink;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.d;
    fill: transparent;
    stroke: root.color;
    stroke-width: 2.2px;
    stroke-line-cap: round;
}

export global Icons {
    out property <string> foveation: "M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7zM9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0";
    out property <string> games: "M6 9h12a4 4 0 0 1 4 4v1a3 3 0 0 1-5.4 1.8L15.5 14h-7l-1.1 1.8A3 3 0 0 1 2 14v-1a4 4 0 0 1 4-4zM7 11.5v3M5.5 13h3";
    out property <string> setup: "M4 7h10M18 7h2M4 17h4M12 17h8M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0";
    out property <string> search: "M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0M16 16l4.5 4.5";
    out property <string> close: "M6 6l12 12M18 6L6 18";
    out property <string> check: "M5 12.5l4.5 4.5L19 7.5";
    out property <string> warn: "M12 3l10 18H2zM12 10v5M12 18v1";
    out property <string> down: "M12 3v10M8 9l4 4 4-4M5 21h14";
    out property <string> sort: "M7 4v16M4 17l3 3 3-3M14 6h7M14 12h5M14 18h3";
    out property <string> chevron: "M9 6l6 6-6 6";
}

// Rounded tile behind an icon: radius 7/32 of its size, as the sibling apps' icon tiles.
export component IconTile inherits Rectangle {
    in property <string> icon;
    in property <brush> tint: Tokens.ink2;
    in property <brush> fill: Tokens.line;
    width: 36px;
    height: self.width;
    border-radius: self.width * 7 / 32;
    background: root.fill;
    Icon {
        d: root.icon;
        width: parent.width * 0.55;
        height: self.width;
        color: root.tint;
    }
}

// Filled button. kind: 0 quiet (line fill), 1 primary (accent), 2 danger outline.
export component Button inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <bool> enabled: true;
    in property <string> icon;
    // Work in progress: the label dims and a bar runs along the bottom edge.
    in property <bool> busy;
    callback clicked();
    height: 36px;
    min-width: max(row.preferred-width, 88px);
    horizontal-stretch: 0;
    border-radius: Tokens.radius-control;
    clip: true;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => {
        root.clicked();
    }
    property <bool> down: hit.pressed && root.enabled;
    background: !root.enabled ? Tokens.raised
        : root.kind == 1 ? (root.down ? Tokens.accent-pressed : Tokens.accent)
        : root.kind == 2 ? (root.down || hit.has-hover ? Tokens.danger-bg : transparent)
        : root.down ? Tokens.dim : hit.has-hover ? Tokens.pressed : Tokens.line;
    animate background {
        duration: root.down ? 0ms : Motion.fast;
        easing: ease-out;
    }
    border-width: root.kind == 2 ? 2px : 0px;
    border-color: Tokens.danger;
    row := HorizontalLayout {
        padding-left: Tokens.space-4;
        padding-right: self.padding-left;
        spacing: Tokens.space-2;
        alignment: center;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                d: root.icon;
                width: 16px;
                height: self.width;
                color: label.color;
            }
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Tokens.type-label;
            font-family: Tokens.font-body;
            font-weight: root.kind == 1 ? 600 : 400;
            opacity: root.busy ? 0.5 : 1;
            color: !root.enabled ? Tokens.ink3 : root.kind == 1 ? Tokens.on-accent : root.kind == 2 ? Tokens.danger-ink : Tokens.ink;
        }
    }
    // Indeterminate progress: a short bar sweeping the bottom edge while busy.
    if root.busy: Rectangle {
        property <float> t: 0;
        y: root.height - 3px;
        height: 3px;
        width: root.width / 3;
        x: -self.width + (root.width + self.width) * self.t;
        background: root.kind == 1 ? Tokens.on-accent : Tokens.accent;
        init => {
            self.t = 1;
        }
        animate t {
            duration: Mode.reduce-motion ? 0ms : 900ms;
            iteration-count: -1;
            easing: ease-in-out;
        }
    }
    hit := Hit {
        enabled: root.enabled && !root.busy;
        clicked => {
            root.clicked();
        }
    }
}

// On / off. The knob slides; the track takes the accent when on.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> hover;
    property <length> pad: 3px;
    width: 44px;
    height: 26px;
    border-radius: self.height / 2;
    background: root.on ? Tokens.accent : root.hover ? Tokens.dim : Tokens.line;
    animate background {
        duration: Motion.fast;
        easing: ease-out;
    }
    Rectangle {
        width: root.height - 2 * root.pad;
        height: self.width;
        y: root.pad;
        x: root.on ? root.width - self.width - root.pad : root.pad;
        border-radius: self.width / 2;
        background: root.on ? Tokens.on-accent : Tokens.ink3;
        animate x {
            duration: Motion.slow;
            easing: cubic-bezier(0.23, 1, 0.32, 1);
        }
        animate background {
            duration: Motion.fast;
            easing: ease-out;
        }
    }
}

// Equal cells across the given width; the chosen one is ink and the highlight slides to a new choice.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback picked(int);
    property <length> pad: 3px;
    property <length> cell: (self.width - 2 * self.pad) / max(1, root.options.length);
    min-width: 72px * root.options.length;
    height: Tokens.size-segment + 2 * self.pad;
    border-radius: Tokens.radius-control;
    background: Tokens.line;
    accessible-role: tab-list;
    accessible-label: root.label;
    Rectangle {
        x: root.pad + root.selected * root.cell;
        y: root.pad;
        width: root.cell;
        height: Tokens.size-segment;
        border-radius: Tokens.radius-small;
        background: Tokens.ink;
        animate x {
            duration: Motion.slow;
            easing: cubic-bezier(0.23, 1, 0.32, 1);
        }
    }
    for option[i] in root.options: Rectangle {
        x: root.pad + i * root.cell;
        y: root.pad;
        width: root.cell;
        height: Tokens.size-segment;
        border-radius: Tokens.radius-small;
        property <bool> on: i == root.selected;
        accessible-role: tab;
        accessible-label: option;
        accessible-item-selected: self.on;
        accessible-action-default => {
            root.picked(i);
        }
        background: self.on ? transparent : h.pressed ? Tokens.dim : h.has-hover ? Tokens.pressed : transparent;
        animate background {
            duration: h.pressed ? 0ms : Motion.fast;
            easing: ease-out;
        }
        Text {
            text: option;
            color: parent.on ? Tokens.on-accent : Tokens.ink2;
            font-size: Tokens.type-label;
            font-family: Tokens.font-body;
            font-weight: parent.on ? 600 : 400;
            overflow: elide;
            animate color {
                duration: Motion.fast;
                easing: ease-out;
            }
        }
        h := Hit {
            clicked => {
                root.picked(i);
            }
        }
    }
}

// A settings row: label (and a quiet second line) on the left, its control on the right. Rows in a Group draw a
// hairline between them.
export component Row inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <bool> divider;
    // A row that is one control (a switch) answers anywhere on it.
    in property <bool> clickable;
    out property <bool> hovered: row-hit.has-hover;
    callback clicked();
    min-height: Tokens.size-row;
    background: root.clickable && row-hit.pressed ? Tokens.pressed : root.clickable && row-hit.has-hover ? Tokens.line : transparent;
    animate background {
        duration: row-hit.pressed ? 0ms : Motion.fast;
        easing: ease-out;
    }
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Tokens.line;
        visible: root.divider;
    }
    row-hit := Hit {
        enabled: root.clickable;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: Tokens.space-5;
        padding-right: self.padding-left;
        padding-top: Tokens.space-2;
        padding-bottom: Tokens.space-2;
        spacing: Tokens.space-3;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Body {
                text: root.label;
                overflow: elide;
            }
            if root.sub != "": Caption {
                text: root.sub;
                overflow: elide;
            }
        }
        @children
    }
}

// The whole row toggles the switch.
export component SwitchRow inherits Row {
    in property <bool> on;
    clickable: true;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => {
        root.clicked();
    }
    VerticalLayout {
        alignment: center;
        Switch {
            on: root.on;
            hover: root.hovered;
        }
    }
}

// Rounded card that holds rows.
export component Group inherits Rectangle {
    in property <brush> fill: Tokens.raised;
    border-radius: Tokens.radius-group;
    background: root.fill;
    clip: true;
    VerticalLayout {
        @children
    }
}

// Status pill. kind: 0 on (accent), 1 neutral, 2 blocked (danger), 3 needs attention (ink outline).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    height: 24px;
    width: t.preferred-width + 2 * Tokens.space-3;
    border-radius: self.height / 2;
    background: root.kind == 0 ? Tokens.accent : root.kind == 2 ? Tokens.danger-bg : transparent;
    border-width: root.kind == 1 || root.kind == 3 ? 1px : 0px;
    border-color: root.kind == 3 ? Tokens.ink : Tokens.dim;
    animate background {
        duration: Motion.fast;
        easing: ease-out;
    }
    t := Text {
        text: root.text;
        font-size: Tokens.type-small;
        font-family: Tokens.font-body;
        font-weight: root.kind == 0 ? 600 : 400;
        color: root.kind == 0 ? Tokens.on-accent : root.kind == 2 ? Tokens.danger-ink : root.kind == 3 ? Tokens.ink : Tokens.ink2;
        vertical-alignment: center;
    }
}
